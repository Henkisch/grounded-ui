{
  "name": "grounded-ui",
  "version": "0.0.0",
  "description": "Executable accessibility contracts for HTML components, a conformance runner, and a zero-JS reference implementation.",
  "license": "MIT",
  "author": "Henrik Larsson",
  "type": "module",
  "files": [
    "reference/**/*.css",
    "contracts/*/contract.yaml",
    "contracts/*/markup/**/*.html",
    "spec/*.json",
    "conformance/src/*",
    "examples/*.html"
  ],
  "scripts": {
    "validate": "node scripts/validate-contracts.mjs",
    "lint:css": "stylelint \"reference/**/*.css\"",
    "check-deps": "node scripts/check-deps.mjs",
    "budget": "node scripts/budget.mjs",
    "check": "pnpm validate && pnpm lint:css && pnpm lint:html && pnpm check-deps && pnpm budget",
    "lint:html": "html-validate \"contracts/*/markup/valid/*.html\" \"examples/*.html\" \"recipes/*.html\"",
    "conformance": "playwright test -c conformance/playwright.config.mjs",
    "report": "node reports/run.mjs",
    "consistency": "node scripts/consistency.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.15.0",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "axe-core": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@webref/elements": "^2.9.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "aria-query": "^5.3.2",
    "govuk-frontend": "6.5.1",
    "html-validate": "^11.16.0",
    "lightningcss": "^1.33.0",
    "stylelint": "^17.15.0",
    "stylelint-plugin-use-baseline": "^1.4.6",
    "stylelint-use-logical": "^2.1.3",
    "web-features": "^3.40.0",
    "yaml": "^2.9.1"
  },
  "bin": {
    "grounded-conformance": "conformance/src/cli.mjs"
  }
}
