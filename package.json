{
  "name": "grund-ui",
  "version": "0.0.0",
  "description": "Native HTML components for existing CMS sites. One CSS link plus copied markup.",
  "license": "MIT",
  "author": "Henrik Larsson",
  "type": "module",
  "files": [
    "core/*.css",
    "components/*/styles/*.css",
    "components/*/markup/*.html",
    "components/*/contract.yaml",
    "examples/*.html"
  ],
  "scripts": {
    "validate": "node scripts/validate-contracts.mjs",
    "lint:css": "stylelint \"core/**/*.css\" \"components/*/styles/**/*.css\"",
    "check-deps": "node scripts/check-deps.mjs",
    "budget": "node scripts/budget.mjs",
    "check": "pnpm validate && pnpm lint:css && pnpm lint:html && pnpm check-deps && pnpm budget",
    "lint:html": "html-validate \"components/*/markup/*.html\" \"examples/*.html\""
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.15.0",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@webref/elements": "^2.9.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "aria-query": "^5.3.2",
    "html-validate": "^11.16.0",
    "lightningcss": "^1.33.0",
    "stylelint": "^17.15.0",
    "stylelint-plugin-use-baseline": "^1.4.6",
    "stylelint-use-logical": "^2.1.3",
    "web-features": "^3.40.0",
    "yaml": "^2.9.1"
  }
}
