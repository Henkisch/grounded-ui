    {
      "source": "docs",
      "name": "live demo, opened",
      "url": "https://getbootstrap.com/docs/5.3/components/modal/",
      "report": [
        {
          "component": "dialog",
          "contractVersion": "0.3.0",
          "implementation": "Bootstrap 5",
          "element": "<div class=\"modal fade show\" id=\"exampleModalLive\" tabindex=\"-1\">",
          "results": [
            {
              "id": "DG-01",
              "level": "recommended",
              "type": "technique",
              "description": "The root is a <dialog> element.",
              "pass": false,
              "detail": "root matches :scope:not(dialog)"
            },
            {
              "id": "DG-02",
              "level": "recommended",
              "type": "technique",
              "description": "The dialog has an id, so triggers can point at it.",
              "pass": true,
              "detail": null
            },
            {
              "id": "DG-03",
              "level": "recommended",
              "type": "technique",
              "description": "There is exactly one title.",
              "pass": true,
              "detail": null
            },
            {
              "id": "DG-04",
              "level": "normative",
              "type": "outcome",
              "description": "The title has non-empty text.",
              "pass": true,
              "detail": null
            },
            {
              "id": "DG-05",
              "level": "normative",
              "type": "outcome",
              "description": "The dialog has a non-empty accessible name.",
              "pass": true,
              "detail": null
            },
            {
              "id": "DG-06",
              "level": "recommended",
              "type": "technique",
              "description": "The name comes from the title, via aria-labelledby pointing at its id.",
              "pass": true,
              "detail": null
            },
            {
              "id": "DG-07",
              "level": "recommended",
              "type": "technique",
              "description": "A trigger on the page points at the dialog with commandfor and command=\"show-modal\".",
              "pass": false,
              "detail": "nothing on the page matches [command=\"show-modal\"][commandfor=\"exampleModalLive\"]"
            },
            {
              "id": "DG-08",
              "level": "recommended",
              "type": "technique",
              "description": "The trigger is a <button>.",
              "pass": true,
              "detail": null
            },
            {
              "id": "DG-09",
              "level": "recommended",
              "type": "technique",
              "description": "The dialog contains a close control (command=\"close\" or a form with method=\"dialog\").",
              "pass": false,
              "detail": "root matches :scope:not(:has([command=\"close\"], form[method=\"dialog\"]))"
            },
            {
              "id": "DG-10",
              "level": "recommended",
              "type": "technique",
              "description": "The dialog is not rendered with a static open attribute; it opens as a modal via show-modal.",
              "pass": true,
              "detail": null
            },
            {
              "id": "DG-11",
              "level": "normative",
              "type": "outcome",
              "description": "On a native <dialog>, the only role override allowed is role=\"alertdialog\".",
              "pass": true,
              "detail": null
            },
            {
              "id": "DG-12",
              "level": "recommended",
              "type": "technique",
              "description": "The dialog itself has no tabindex.",
              "pass": false,
              "detail": "root matches :scope[tabindex]"
            },
            {
              "id": "DG-13",
              "level": "recommended",
              "type": "technique",
              "description": "The alert variant has role=\"alertdialog\" and no light dismiss.",
              "pass": true,
              "detail": null
            },
            {
              "id": "DG-14",
              "level": "normative",
              "type": "outcome",
              "description": "The dialog has the role dialog or alertdialog.",
              "pass": true,
              "detail": null
            },
            {
              "id": "DG-15",
              "level": "recommended",
              "type": "outcome",
              "description": "The dialog's accessible name contains its title text.",
              "pass": true,
              "detail": null
            },
            {
              "id": "DG-16",
              "level": "recommended",
              "type": "outcome",
              "description": "The dialog contains a button.",
              "pass": true,
              "detail": null
            }
          ],
          "axeViolations": []
        }
