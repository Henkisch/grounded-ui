lass=\"report-field\"><label class=\"usa-label\" for=\"input-type-textarea-aria-disabled\">Text area aria-disabled</label>\n<textarea class=\"usa-textarea\" id=\"input-type-textarea-aria-disabled\" name=\"input-type-textarea-aria-disabled\" aria-disabled=\"true\"></textarea></div>"
