              "detail": null
            },
            {
              "id": "DG-12",
              "level": "recommended",
              "type": "technique",
              "description": "The dialog itself has no tabindex.",
              "pass": false,
              "detail": "root matches :scope[tabindex]"
            },
            {
              "id": "DG-13",
              "level": "recommended",
              "type": "technique",
              "description": "The alert variant has role=\"alertdialog\" and no light dismiss.",
              "pass": true,
              "detail": null
            },
            {
              "id": "DG-14",
              "level": "normative",
              "type": "outcome",
              "description": "The dialog has the role dialog or alertdialog.",
              "pass": false,
              "detail": "<div class=\"dialog-widget dialog-lightbox-widget dialog-type-buttons dialog-type-lightbox elementor-popup-modal\" id=\"elementor-popup-modal-226\" aria-modal=\"true\"> has role \"document\", expected dialog or alertdialog"
            },
            {
              "id": "DG-15",
              "level": "recommended",
              "type": "outcome",
              "description": "The dialog's accessible name contains its title text.",
