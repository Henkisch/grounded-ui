{
  "implementation": "Försäkringskassan FKUI",
  "version": "6.59.0",
  "contract": "0.2.1",
  "examples": [
    {
      "source": "docs",
      "name": "fmodal.html, opened",
      "url": "https://designsystem.forsakringskassan.se/latest/components/modal/fmodal.html",
      "report": [
        {
          "component": "dialog",
          "contractVersion": "0.2.1",
          "implementation": "Försäkringskassan FKUI",
          "element": "<div class=\"modal__outer-container scroll-target\" tabindex=\"-1\" role=\"dialog\">",
          "results": [
            {
              "id": "DG-01",
              "level": "recommended",
              "description": "The root is a <dialog> element.",
              "pass": false,
              "detail": "root matches :scope:not(dialog)"
            },
            {
              "id": "DG-02",
              "level": "recommended",
              "description": "The dialog has an id, so triggers can point at it.",
              "pass": false,
              "detail": "root matches :scope:not([id])"
            },
            {
              "id": "DG-03",
              "level": "recommended",
              "description": "There is exactly one title.",
              "pass": true,
              "detail": null
            },
            {
              "id": "DG-04",
              "level": "normative",
              "description": "The title has non-empty text.",
              "pass": true,
              "detail": null
            },
            {
              "id": "DG-05",
              "level": "normative",
              "description": "The dialog has an accessible name via aria-labelledby.",
              "pass": false,
              "detail": "root matches :scope:not([aria-labelledby])"
            },
            {
              "id": "DG-06",
              "level": "recommended",
              "description": "aria-labelledby points at the title's id.",
              "pass": false,
              "detail": "aria-labelledby=\"\" but id=\"\""
            },
            {
              "id": "DG-07",
              "level": "recommended",
              "description": "A trigger on the page points at the dialog with commandfor and command=\"show-modal\".",
              "pass": false,
              "detail": "the root has no id to reference"
            },
            {
              "id": "DG-08",
              "level": "recommended",
              "description": "The trigger is a <button>.",
              "pass": true,
              "detail": null
            },
            {
              "id": "DG-09",
              "level": "recommended",
              "description": "The dialog contains a close control (command=\"close\" or a form with method=\"dialog\").",
              "pass": false,
              "detail": "root matches :scope:not(:has([command=\"close\"], form[method=\"dialog\"]))"
            },
            {
              "id": "DG-10",
              "level": "recommended",
              "description": "The dialog is not rendered with a static open attribute; it opens as a modal via show-modal.",
              "pass": true,
              "detail": null
            },
            {
              "id": "DG-11",
              "level": "normative",
              "description": "On a native <dialog>, the only role override allowed is role=\"alertdialog\".",
              "pass": true,
              "detail": null
            },
            {
              "id": "DG-12",
              "level": "recommended",
              "description": "The dialog itself has no tabindex.",
              "pass": false,
              "detail": "root matches :scope[tabindex]"
            },
            {
              "id": "DG-13",
              "level": "recommended",
              "description": "The alert variant has role=\"alertdialog\" and no light dismiss.",
              "pass": true,
              "detail": null
            }
          ],
          "axeViolations": [
            {
              "id": "aria-dialog-name",
              "impact": "serious",
              "help": "ARIA dialog and alertdialog nodes should have an accessible name"
            }
          ]
        }
      ]
    },
