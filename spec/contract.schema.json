{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grounded-ui.dev/schema/contract.schema.json",
  "title": "grounded-ui component contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component",
    "contractVersion",
    "title",
    "anatomy",
    "rules"
  ],
  "properties": {
    "component": {
      "$ref": "#/$defs/slug"
    },
    "contractVersion": {
      "$ref": "#/$defs/semver"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "css": {
          "type": "integer",
          "minimum": 0
        },
        "js": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "anatomy": {
      "type": "object",
      "required": [
        "root"
      ],
      "propertyNames": {
        "$ref": "#/$defs/slug"
      },
      "additionalProperties": {
        "$ref": "#/$defs/part"
      }
    },
    "domOrder": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      },
      "uniqueItems": true
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/slug"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "hook"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/slug"
          },
          "dom": {
            "type": "string"
          },
          "hook": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "wcag": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "name",
          "level",
          "how"
        ],
        "properties": {
          "criterion": {
            "$ref": "#/$defs/criterion"
          },
          "level": {
            "enum": [
              "A",
              "AA",
              "AAA"
            ]
          },
          "name": {
            "type": "string"
          },
          "how": {
            "type": "string"
          }
        }
      }
    },
    "siteResponsibilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "text"
        ],
        "properties": {
          "criterion": {
            "$ref": "#/$defs/criterion"
          },
          "text": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "editor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "help": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "softWarnings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Z]{2,3}-W\\d+$"
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature"
        ],
        "properties": {
          "feature": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "$comment": "web-features id"
          },
          "optional": {
            "type": "boolean"
          },
          "fallback": {
            "type": "string"
          }
        }
      }
    },
    "keyboard": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "behavior"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "behavior": {
            "type": "string"
          }
        }
      }
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "on",
          "name",
          "type",
          "description"
        ],
        "properties": {
          "on": {
            "$ref": "#/$defs/slug",
            "$comment": "an anatomy key"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "type": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "default": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "customProperties": {
      "type": "object",
      "propertyNames": {
        "pattern": "^--grounded-[a-z0-9-]+$"
      },
      "additionalProperties": {
        "type": "string"
      },
      "$comment": "must equal the set of var(--grounded-*) used in the component CSS"
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "criterion": {
      "type": "string",
      "pattern": "^\\d\\.\\d+\\.\\d+$"
    },
    "selector": {
      "type": "string",
      "minLength": 1
    },
    "attrRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "attr"
      ],
      "properties": {
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "attr": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "element"
      ],
      "properties": {
        "element": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "required": {
          "type": "boolean"
        },
        "requiredWhen": {
          "$ref": "#/$defs/selector"
        },
        "label": {
          "type": "string"
        },
        "outside": {
          "type": "boolean",
          "$comment": "lives outside the component root, e.g. a dialog trigger"
        }
      }
    },
    "test": {
      "type": "object",
      "required": [
        "kind"
      ],
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "absent"
            },
            "selector": {
              "$ref": "#/$defs/selector"
            },
            "scope": {
              "enum": [
                "root",
                "document"
              ],
              "$comment": "root (default): the root matches or contains a match. document: anywhere on the page; {id} is the root's id."
            }
          },
          "required": [
            "selector"
          ]
        },
        {
          "additionalProperties": false,
          "required": [
            "selector",
            "equals"
          ],
          "properties": {
            "kind": {
              "const": "count"
            },
            "selector": {
              "$ref": "#/$defs/selector"
            },
            "equals": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "selector"
          ],
          "properties": {
            "kind": {
              "const": "nonEmptyText"
            },
            "selector": {
              "$ref": "#/$defs/selector"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "a",
            "b"
          ],
          "properties": {
            "kind": {
              "const": "attrEquals"
            },
            "a": {
              "$ref": "#/$defs/attrRef"
            },
            "b": {
              "$ref": "#/$defs/attrRef"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "kind": {
              "enum": [
                "idrefIncludes",
                "idrefFirst"
              ]
            },
            "from": {
              "$ref": "#/$defs/attrRef"
            },
            "to": {
              "$ref": "#/$defs/selector"
            }
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "uniqueIds"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "attr"
          ],
          "properties": {
            "kind": {
              "const": "referencedBy"
            },
            "attr": {
              "type": "string",
              "minLength": 1
            },
            "where": {
              "$ref": "#/$defs/selector"
            }
          },
          "$comment": "the document contains an element (matching where) whose attr equals the root's id"
        },
        {
          "additionalProperties": false,
          "required": [
            "selector"
          ],
          "properties": {
            "kind": {
              "const": "name"
            },
            "selector": {
              "$ref": "#/$defs/selector"
            },
            "includes": {
              "$ref": "#/$defs/selector"
            }
          },
          "$comment": "the element has a non-empty computed accessible name; with includes, the name contains the words of that part (skipped when the part is missing or the name is empty)"
        },
        {
          "additionalProperties": false,
          "required": [
            "selector",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "exposes"
            },
            "selector": {
              "$ref": "#/$defs/selector"
            },
            "text": {
              "$ref": "#/$defs/selector"
            }
          },
          "$comment": "when the text part exists and has text, its words appear in the element computed accessible description or name"
        },
        {
          "additionalProperties": false,
          "required": [
            "selector",
            "oneOf"
          ],
          "properties": {
            "kind": {
              "const": "role"
            },
            "selector": {
              "$ref": "#/$defs/selector"
            },
            "oneOf": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "$comment": "the element computed ARIA role is one of these (ARIA role names, checked against aria-query)"
        },
        {
          "additionalProperties": false,
          "required": [
            "control",
            "error"
          ],
          "properties": {
            "kind": {
              "const": "invalidHasError"
            },
            "control": {
              "$ref": "#/$defs/selector"
            },
            "error": {
              "$ref": "#/$defs/selector"
            }
          },
          "$comment": "every control with aria-invalid=\"true\" has an error part inside the root, or references one (e.g. on a parent fieldset) through aria-describedby or aria-errormessage"
        }
      ],
      "properties": {
        "kind": {
          "enum": [
            "absent",
            "count",
            "nonEmptyText",
            "attrEquals",
            "idrefIncludes",
            "idrefFirst",
            "uniqueIds",
            "referencedBy",
            "name",
            "exposes",
            "role",
            "invalidHasError"
          ]
        }
      }
    },
    "css": {
      "oneOf": [
        {
          "const": false
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "violation",
            "message"
          ],
          "properties": {
            "violation": {
              "$ref": "#/$defs/selector"
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "coverage": {
              "enum": [
                "full",
                "partial"
              ]
            },
            "pseudo": {
              "enum": [
                "before",
                "after"
              ]
            }
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "level",
        "type",
        "source",
        "rationale",
        "since",
        "test",
        "css"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{2,3}-\\d{2}$"
        },
        "since": {
          "$ref": "#/$defs/semver"
        },
        "test": {
          "$ref": "#/$defs/test"
        },
        "css": {
          "$ref": "#/$defs/css"
        },
        "editor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level"
          ],
          "properties": {
            "level": {
              "enum": [
                "refuse",
                "warn"
              ]
            }
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "enum": [
            "normative",
            "recommended"
          ],
          "$comment": "normative: a standard requires it; recommended: our judgement, open to review"
        },
        "type": {
          "enum": [
            "outcome",
            "technique"
          ],
          "$comment": "outcome: what any implementation must achieve, judged on the rendered result (computed name, role, description, visible text). technique: how Grounded UI reference markup achieves it; a recommendation, not a verdict on other implementations."
        },
        "source": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "description": "Contract format for grounded-ui components. Test selectors use part tokens ({label}, {control}, \u2026) that a binding maps to an implementation's markup; :scope is the component root."
}
