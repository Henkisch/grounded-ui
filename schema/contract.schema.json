{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grund-ui.dev/schema/contract.schema.json",
  "title": "grund-ui component contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component",
    "contractVersion",
    "title",
    "anatomy",
    "markup",
    "rules"
  ],
  "properties": {
    "component": {
      "$ref": "#/$defs/slug"
    },
    "contractVersion": {
      "$ref": "#/$defs/semver"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "css": {
          "type": "integer",
          "minimum": 0
        },
        "js": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "anatomy": {
      "type": "object",
      "required": [
        "root"
      ],
      "propertyNames": {
        "$ref": "#/$defs/slug"
      },
      "additionalProperties": {
        "$ref": "#/$defs/part"
      }
    },
    "domOrder": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      },
      "uniqueItems": true
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/slug"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "hook"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/slug"
          },
          "dom": {
            "type": "string"
          },
          "hook": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "markup": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "wcag": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "name",
          "level",
          "how"
        ],
        "properties": {
          "criterion": {
            "$ref": "#/$defs/criterion"
          },
          "level": {
            "enum": [
              "A",
              "AA",
              "AAA"
            ]
          },
          "name": {
            "type": "string"
          },
          "how": {
            "type": "string"
          }
        }
      }
    },
    "siteResponsibilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "text"
        ],
        "properties": {
          "criterion": {
            "$ref": "#/$defs/criterion"
          },
          "text": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "editor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "help": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "softWarnings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Z]{2,3}-W\\d+$"
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "criterion": {
      "type": "string",
      "pattern": "^\\d\\.\\d+\\.\\d+$"
    },
    "selector": {
      "type": "string",
      "minLength": 1
    },
    "attrRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "attr"
      ],
      "properties": {
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "attr": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "element"
      ],
      "properties": {
        "part": {
          "$ref": "#/$defs/slug"
        },
        "element": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "required": {
          "type": "boolean"
        },
        "requiredWhen": {
          "$ref": "#/$defs/selector"
        },
        "attrs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "label": {
          "type": "string"
        }
      }
    },
    "test": {
      "type": "object",
      "required": [
        "kind"
      ],
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "absent"
            },
            "selector": {
              "$ref": "#/$defs/selector"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "selector",
            "equals"
          ],
          "properties": {
            "kind": {
              "const": "count"
            },
            "selector": {
              "$ref": "#/$defs/selector"
            },
            "equals": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "selector"
          ],
          "properties": {
            "kind": {
              "const": "nonEmptyText"
            },
            "selector": {
              "$ref": "#/$defs/selector"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "a",
            "b"
          ],
          "properties": {
            "kind": {
              "const": "attrEquals"
            },
            "a": {
              "$ref": "#/$defs/attrRef"
            },
            "b": {
              "$ref": "#/$defs/attrRef"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "kind": {
              "enum": [
                "idrefIncludes",
                "idrefFirst"
              ]
            },
            "from": {
              "$ref": "#/$defs/attrRef"
            },
            "to": {
              "$ref": "#/$defs/selector"
            }
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "uniqueIds"
            }
          }
        }
      ]
    },
    "css": {
      "oneOf": [
        {
          "const": false
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "violation",
            "message"
          ],
          "properties": {
            "violation": {
              "$ref": "#/$defs/selector"
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "coverage": {
              "enum": [
                "full",
                "partial"
              ]
            },
            "pseudo": {
              "enum": [
                "before",
                "after"
              ]
            }
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "since",
        "test",
        "css"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{2,3}-\\d{2}$"
        },
        "since": {
          "$ref": "#/$defs/semver"
        },
        "test": {
          "$ref": "#/$defs/test"
        },
        "css": {
          "$ref": "#/$defs/css"
        },
        "editor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level"
          ],
          "properties": {
            "level": {
              "enum": [
                "refuse",
                "warn"
              ]
            }
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "test": {
            "properties": {
              "kind": {
                "const": "absent"
              }
            },
            "not": {
              "required": [
                "selector"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "css": {
            "type": "object"
          }
        },
        "$comment": "absent without its own selector reuses css.violation, so css must be an object"
      }
    }
  }
}
